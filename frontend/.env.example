# Development: browser talks directly to local FastAPI/mock.
NEXT_PUBLIC_OPTIONBEACON_API_URL=http://localhost:8000
NEXT_PUBLIC_OPTIONBEACON_SNAPSHOT_POLL_MS=15000
NEXT_PUBLIC_OPTIONBEACON_SNAPSHOT_SAFETY_POLL_MS=60000

# To exercise the production same-origin proxy locally, leave the public URL
# empty and point the Next.js server at FastAPI. Never prefix this with NEXT_PUBLIC_.
# OPTIONBEACON_API_ORIGIN=http://localhost:8000
# NEXT_PUBLIC_OPTIONBEACON_API_URL=

# Production Railway (frontend service, server-only):
# OPTIONBEACON_API_ORIGIN=http://${{api.RAILWAY_PRIVATE_DOMAIN}}:${{api.PORT}}
# Do not set NEXT_PUBLIC_OPTIONBEACON_API_URL in production.
